<div class="max-w-xl mx-auto mt-16 px-4">
  <h1 class="text-2xl font-bold mb-2">Watch Spec Concierge</h1>
  <p class="text-gray-500 mb-6">Type in a watch and get the specs, AI-researched on the fly.</p>

  <%= form_with url: "/lookup", method: :post, class: "flex gap-2 mb-8" do %>
    <%= text_field_tag :query, params[:query], placeholder: "e.g. Oris Big Crown Pointer Date",
        class: "border rounded px-3 py-2 flex-1" %>
    <%= submit_tag "Look it up", class: "bg-black text-white px-4 py-2 rounded",
    data: { turbo_submits_with: "Looking it up..." } %>
    <%= link_to "Cancel", root_path, class: "border px-4 py-2 rounded text-gray-600 hover:bg-gray-50" %>
  <% end %>

  <% if @result %>
    <% if @result["error"] %>
      <p class="text-red-500"><%= @result["error"] %></p>
    <% else %>
      <div class="border rounded p-5">
        <h2 class="text-lg font-semibold"><%= @result["brand"] %> — <%= @result["model"] %></h2>
        <dl class="mt-3 space-y-1 text-sm text-gray-700">
          <div><dt class="inline font-medium">Movement:</dt> <dd class="inline"><%= @result["movement"] %></dd></div>
          <div><dt class="inline font-medium">Case:</dt> <dd class="inline"><%= @result["case_diameter"] %></dd></div>
          <div><dt class="inline font-medium">Water resistance:</dt> <dd class="inline"><%= @result["water_resistance"] %></dd></div>
          <div><dt class="inline font-medium">Price range:</dt> <dd class="inline"><%= @result["price_range"] %></dd></div>
        </dl>
        <p class="mt-4 text-sm italic text-gray-600"><%= @result["notable_trivia"] %></p>
      </div>
    <% end %>
  <% end %>
</div>

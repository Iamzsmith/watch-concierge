<div class="max-w-xl mx-auto mt-16 px-4">
  <h1 class="text-2xl font-bold mb-2">Watch Spec Concierge</h1>
  <p class="text-gray-500 mb-6">Type in a watch and get the specs, AI-researched on the fly.</p>
  <%= form_with url: "/lookup", method: :post, class: "flex gap-2 mb-8" do %>
    <%= text_field_tag :query, params[:query], placeholder: "e.g. Oris Big Crown Pointer Date",
        class: "border rounded px-3 py-2 flex-1" %>
    <%= submit_tag "Look it up", class: "bg-black text-white px-4 py-2 rounded" %>
  <% end %>
</div>
